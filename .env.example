# Momentum game server configuration (all optional).
# Copy to .env and load it with your process manager (systemd EnvironmentFile, docker --env-file, …).

# Network
SERVER_PORT=8787
HOST=0.0.0.0
# Set when running behind a reverse proxy (nginx/Caddy) so rate limits see real client IPs.
TRUST_PROXY=false
# Comma-separated list of allowed browser origins for WebSocket connections (empty = any).
ALLOWED_ORIGINS=

# Identity shown in the server browser
SERVER_NAME=Momentum Server
SERVER_REGION=Local

# Simulation
TICK_RATE=60          # 30, 60 or 120
SNAPSHOT_RATE=60      # snapshots per second sent to clients (<= TICK_RATE)

# Capacity & rooms
MAX_PLAYERS=12        # per room
MAX_ROOMS=200
MAX_CONNECTIONS=2000
MAX_CONNECTIONS_PER_IP=8
PUBLIC_ROOMS=1        # always-on drop-in public rooms
ROOM_PASSWORD=        # password for the always-on public rooms (empty = open)
RECONNECT_WINDOW_SEC=30
EMPTY_ROOM_TIMEOUT_SEC=60

# Built-in TLS (optional; usually terminate TLS in nginx/Caddy instead)
TLS_CERT=
TLS_KEY=

# Static client files
STATIC_DIR=dist/client

# Observability
LOG_LEVEL=info        # debug | info | warn | error
LOG_FORMAT=pretty     # pretty | json
METRICS_TOKEN=        # when set, GET /api/metrics requires "Authorization: Bearer <token>"
METRICS_LOG_INTERVAL_SEC=0
